<title>AI YouTube Thumbnail Gallery</title>
<style>
  :root {
    --bg: #faf7f2;
    --surface: #ffffff;
    --surface-2: #f0ebe2;
    --text: #1e1b17;
    --text-dim: #77706a;
    --line: #e4ddd1;
    --accent: #c96a2e;
    --out: #b07f1a;
    --out-ring: #d9a521;
    --shadow: 0 1px 3px rgba(30, 27, 23, 0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f0f;
      --surface: #1a1a1a;
      --surface-2: #242424;
      --text: #f1f1f1;
      --text-dim: #9a9a9a;
      --line: #2c2c2c;
      --accent: #e8833a;
      --out: #ffd75e;
      --out-ring: #d9a521;
      --shadow: none;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f0f0f;
    --surface: #1a1a1a;
    --surface-2: #242424;
    --text: #f1f1f1;
    --text-dim: #9a9a9a;
    --line: #2c2c2c;
    --accent: #e8833a;
    --out: #ffd75e;
    --out-ring: #d9a521;
    --shadow: none;
  }
  :root[data-theme="light"] {
    --bg: #faf7f2;
    --surface: #ffffff;
    --surface-2: #f0ebe2;
    --text: #1e1b17;
    --text-dim: #77706a;
    --line: #e4ddd1;
    --accent: #c96a2e;
    --out: #b07f1a;
    --out-ring: #d9a521;
    --shadow: 0 1px 3px rgba(30, 27, 23, 0.08);
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 15px;
    line-height: 1.45;
    -webkit-text-size-adjust: 100%;
  }

  header.top {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 10px 14px 0;
  }
  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .masthead h1 {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .masthead .meta {
    font-size: 12px;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .controls {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px 0 10px;
  }
  .chipbar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
  }
  .chipbar::-webkit-scrollbar { display: none; }
  .chip {
    flex: 0 0 auto;
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .chip:focus-visible, .toggle:focus-visible, .thumb:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .toggle {
    flex: 0 0 auto;
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .toggle[aria-pressed="true"] {
    background: var(--out);
    border-color: var(--out);
    color: #1e1b17;
  }

  main { padding: 4px 14px 60px; max-width: 1100px; margin: 0 auto; }

  section.channel { padding-top: 18px; }
  .ch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 0 10px;
  }
  .ch-head h2 {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }
  .ch-head .stats {
    font-size: 11.5px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .thumb {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    text-align: left;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    color: var(--text);
    font: inherit;
  }
  .thumb.is-out { border-color: var(--out-ring); box-shadow: 0 0 0 1px var(--out-ring); }
  .thumb img { width: 100%; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
  .cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px;
    font-size: 11px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .cap .views { font-weight: 700; color: var(--text); }
  .badge {
    background: var(--out);
    color: #1e1b17;
    font-weight: 800;
    font-size: 10px;
    border-radius: 4px;
    padding: 1px 5px;
    letter-spacing: 0.02em;
  }
  .mult { white-space: nowrap; }

  .hidden { display: none !important; }

  /* Lightbox */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.82);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .lb.open { display: flex; }
  .lb-card {
    background: var(--surface);
    border-radius: 14px;
    max-width: 720px;
    width: 100%;
    max-height: 92vh;
    overflow-y: auto;
    border: 1px solid var(--line);
  }
  .lb-card img { width: 100%; display: block; }
  .lb-body { padding: 12px 14px 16px; }
  .lb-title { font-size: 14.5px; font-weight: 700; margin: 0 0 6px; }
  .lb-stats { font-size: 12px; color: var(--text-dim); font-variant-numeric: tabular-nums; margin: 0 0 12px; }
  .lb-actions { display: flex; gap: 8px; }
  .lb-actions a, .lb-actions button {
    flex: 1;
    text-align: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 8px;
    padding: 9px 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
  }
  .lb-actions a.watch { background: var(--accent); border-color: var(--accent); color: #fff; }

  .backtop {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 20;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    border-radius: 999px;
    width: 42px;
    height: 42px;
    font-size: 18px;
    cursor: pointer;
    box-shadow: var(--shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
</style>

<header class="top">
  <div class="masthead">
    <h1>AI YouTube Thumbnail Gallery</h1>
    <span class="meta">{{ total_thumbs }} thumbnails · {{ channels|length }} channels</span>
  </div>
  <div class="controls">
    <button class="toggle" id="outToggle" aria-pressed="false">★ Outliers only</button>
    <nav class="chipbar" aria-label="Jump to channel">
      {% for ch in channels %}<a class="chip" href="#{{ ch.slug }}">{{ ch.name }}</a>{% endfor %}
    </nav>
  </div>
</header>

<main>
  {% for ch in channels %}
  <section class="channel" id="{{ ch.slug }}">
    <div class="ch-head">
      <h2>{{ ch.name }}</h2>
      <span class="stats">{{ ch.subs }} subs · avg {{ ch.avg }} views</span>
    </div>
    <div class="grid">
      {% for v in ch.videos %}
      <button class="thumb{% if v.is_out %} is-out{% endif %}"
              data-title="{{ v.title|e }}"
              data-vid="{{ v.id }}"
              data-stats="{{ v.stats_line }}"
              {% if v.is_out %}data-out="1"{% endif %}>
        <img src="{{ v.data_uri }}" alt="{{ v.title|e }}" loading="lazy" decoding="async">
        <span class="cap">
          <span class="views">{{ v.views_fmt }}</span>
          <span class="mult">{% if v.is_out %}<span class="badge">{{ v.outlier_fmt }}</span>{% else %}{{ v.outlier_fmt }}{% endif %}</span>
        </span>
      </button>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Thumbnail detail">
  <div class="lb-card">
    <img id="lbImg" src="" alt="">
    <div class="lb-body">
      <p class="lb-title" id="lbTitle"></p>
      <p class="lb-stats" id="lbStats"></p>
      <div class="lb-actions">
        <a class="watch" id="lbWatch" href="#" target="_blank" rel="noopener">Watch on YouTube</a>
        <button id="lbClose">Close</button>
      </div>
    </div>
  </div>
</div>

<button class="backtop" id="backTop" aria-label="Back to top">↑</button>

<script>
  const lb = document.getElementById('lb');
  const lbImg = document.getElementById('lbImg');
  const lbTitle = document.getElementById('lbTitle');
  const lbStats = document.getElementById('lbStats');
  const lbWatch = document.getElementById('lbWatch');

  document.querySelectorAll('.thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      lbImg.src = btn.querySelector('img').src;
      lbImg.alt = btn.dataset.title;
      lbTitle.textContent = btn.dataset.title;
      lbStats.textContent = btn.dataset.stats;
      lbWatch.href = 'https://youtu.be/' + btn.dataset.vid;
      lb.classList.add('open');
    });
  });
  document.getElementById('lbClose').addEventListener('click', () => lb.classList.remove('open'));
  lb.addEventListener('click', e => { if (e.target === lb) lb.classList.remove('open'); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') lb.classList.remove('open'); });

  const outToggle = document.getElementById('outToggle');
  outToggle.addEventListener('click', () => {
    const on = outToggle.getAttribute('aria-pressed') !== 'true';
    outToggle.setAttribute('aria-pressed', String(on));
    document.querySelectorAll('.thumb').forEach(t => {
      t.classList.toggle('hidden', on && !t.dataset.out);
    });
    document.querySelectorAll('section.channel').forEach(s => {
      const any = s.querySelector('.thumb:not(.hidden)');
      s.classList.toggle('hidden', on && !any);
    });
  });

  document.getElementById('backTop').addEventListener('click', () =>
    window.scrollTo({ top: 0 }));
</script>
