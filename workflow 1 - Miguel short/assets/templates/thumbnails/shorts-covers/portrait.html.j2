<!doctype html>
<html><head><meta charset="utf-8"><style>
@font-face{font-family:Mono;src:url('{{ font_uri }}');font-weight:700}
@font-face{font-family:Mono;src:url('{{ heavy_font_uri }}');font-weight:800}
{% for weight, uri in extra_font_uris|default({})|dictsort %}
@font-face{font-family:Mono;src:url('{{ uri }}');font-weight:{{ weight }}}
{% endfor %}
*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#F6F1EA;color:#141416;font-family:Mono;font-weight:700}
.abs{position:absolute}.canvas{position:relative;width:1080px;height:1920px;overflow:hidden}
.brand{position:absolute;left:76px;top:108px;font-size:23px;letter-spacing:3px;display:flex;align-items:center;gap:20px}.brand:before{content:'';width:48px;height:5px;background:#C4573A}
.title{position:absolute;left:76px;top:310px;width:928px;margin:0;font-size:{{ size }}px;line-height:1.07;letter-spacing:2px;font-weight:700;font-synthesis:none;z-index:4}.title span{display:block}.title .accent{color:#C4573A}
.art{position:absolute;left:{{ art_x|default(360) }}px;top:{{ art_y|default(680) }}px;width:{{ art_w|default(360) }}px;height:{{ art_h|default(270) }}px;z-index:2}
.art svg{width:100%;height:100%;overflow:visible;stroke:#141416;stroke-width:6;fill:#FFFDF9;stroke-linecap:round;stroke-linejoin:round}.art .terra{stroke:#C4573A}.art .none{fill:none}
.subject{position:absolute;left:{{ subject_x }}px;bottom:{{ subject_bottom|default(0) }}px;width:{{ subject_w }}px;z-index:3;display:block}
.footer{position:absolute;bottom:53px;left:76px;font-size:22px;letter-spacing:2px;z-index:5;color:#FFFDF9}
.ig-frame{position:absolute;left:48px;top:235px;width:984px;height:1480px;border:3px solid rgba(20,20,22,.15);border-radius:30px;background:#FFFDF9}
.instagram .subject{clip-path:inset(0 0 0 0 round 0 0 24px 24px)}
.photo-window{position:absolute;left:48px;top:235px;width:984px;height:1480px;overflow:hidden;border-radius:30px;z-index:3}.photo-window .subject{left:{{ subject_x - 48 }}px;bottom:{{ subject_bottom|default(207) - 205 }}px}
.instagram .brand{top:110px}.instagram .footer{color:#141416;bottom:115px}
.instagram .title{left:90px;width:900px;top:325px}
.ruled{position:absolute;left:90px;right:90px;top:{{ rule_y|default(640) }}px;height:5px;background:#C4573A;z-index:1}
{% if variant == 'tt02' %}.title{left:92px;top:330px}.art{left:350px;top:670px}{% endif %}
{% if variant == 'tt03' %}.title{top:310px;text-align:center}.art{left:368px;top:695px}{% endif %}
{% if variant == 'tt04' %}.title{top:320px;left:96px}.art{left:635px;top:675px;width:300px}{% endif %}
{% if variant == 'tt05' %}.title{top:335px;text-align:center}.art{left:360px;top:695px}{% endif %}
{% if variant == 'ig02' %}.title{font-size:112px}.art{left:135px;top:790px;width:325px}.ig-frame{background:#F6F1EA;border-color:#C4573A}{% endif %}
{% if variant == 'ig03' %}.title{text-align:center}.art{left:380px;top:695px;width:320px}.ig-frame{border:none}{% endif %}
{% if variant == 'ig04' %}.title{left:100px}.art{left:670px;top:755px;width:225px}{% endif %}
{% if variant == 'ig05' %}.title{text-align:center}.art{left:350px;top:650px;width:380px;height:200px}.ig-frame{border-top:6px solid #C4573A}{% endif %}
/* All meaningful content survives both centred 3:4 and 4:5 previews. */
.brand,.instagram .brand{top:315px;left:84px;z-index:5}
.title,.instagram .title{top:385px;left:90px;width:900px;font-size:{{ [size,title_max_size|default(128)]|min }}px;font-weight:{{ title_weight|default(700) }};line-height:{{ title_leading|default(1.07) }}}
.art{left:390px;top:682px;width:300px;height:190px}
.subject{left:{{ safe_subject_x }}px;width:{{ safe_subject_w }}px;height:640px;bottom:360px}
.ig-frame{left:48px;top:292px;width:984px;height:1334px}
.photo-window{left:48px;top:292px;width:984px;height:1268px;border-radius:24px}
.photo-window .subject{left:{{ safe_subject_x - 48 }}px;width:{{ safe_subject_w }}px;height:640px;bottom:0}
.footer,.instagram .footer{top:1584px;bottom:auto;left:84px;color:#141416;font-size:22px}
.portrait-base{position:absolute;left:48px;top:1560px;width:984px;height:2px;background:rgba(20,20,22,.15);z-index:4}
{% if variant == 'tt04' %}.art{left:650px;top:726px;width:290px;height:185px}{% endif %}
{% if variant == 'ig02' %}.art{left:135px;top:754px;width:300px;height:190px}{% endif %}
{% if variant == 'ig04' %}.art{left:655px;top:744px;width:245px;height:175px}{% endif %}
{% if variant == 'ig05' %}.art{left:365px;top:682px;width:350px;height:190px}{% endif %}
</style></head><body><main class="canvas {{ platform }}">
<div class="brand">MIGUEL TORREZ AI</div>
{% if platform == 'instagram' %}<div class="ig-frame"></div>{% endif %}
<h1 class="title">{% for line in lines %}<span {% if loop.last %}class="accent"{% endif %}>{{ line }}</span>{% endfor %}</h1>
{% if rule %}<div class="ruled"></div>{% endif %}
{% if icon and icon != 'none' %}<div class="art"><svg viewBox="0 0 360 270">
{% if icon == 'spark' %}
<path d="M180 25 L203 100 L280 122 L203 146 L180 222 L157 146 L80 122 L157 100 Z"/><path class="terra none" d="M284 35v36m-18-18h36M59 190v28m-14-14h28"/>
{% elif icon == 'toolbox' %}
<rect x="58" y="80" width="244" height="153" rx="18"/><path class="none" d="M134 80V48h92v32M58 143h244"/><rect class="terra" x="161" y="123" width="38" height="46" rx="7"/>
{% elif icon == 'plug' %}
<path class="none" d="M112 38v53m68-53v53"/><path d="M84 91h124v46a62 62 0 0 1-124 0Z"/><path class="terra none" d="M146 200v15q0 26 32 26h70q35 0 35-34v-31"/><path class="terra none" d="M267 189l16-16 16 16"/>
{% elif icon == 'book' %}
<path d="M180 69q-53-41-121-20v158q70-16 121 18q51-34 121-18V49q-68-21-121 20Z"/><path class="none" d="M180 69v156M89 90l57 14M89 125l57 14"/><path class="terra none" d="M214 113l18 18 40-44"/>
{% elif icon == 'arrow' %}
<path class="none" d="M65 213V102h80v111M164 213V148h80v65"/><path class="terra none" d="M76 72h218v110M248 143l46 43 42-43"/>
{% elif icon == 'edit' %}
<rect x="68" y="30" width="190" height="205" rx="16"/><path class="none" d="M101 72h124M101 110h78M101 148h42"/><path class="terra" d="M193 168l73-73 26 26-73 73-40 14Z"/><path class="terra none" d="M254 108l26 26"/>
{% elif icon == 'chip' %}
<rect x="91" y="47" width="178" height="178" rx="22"/><rect class="terra" x="137" y="93" width="86" height="86" rx="10"/><path class="none" d="M129 22v25m51-25v25m51-25v25M129 225v25m51-25v25m51-25v25M66 85h25m-25 51h25m-25 51h25M269 85h25m-25 51h25m-25 51h25"/>
{% elif icon == 'bulb' %}
<path d="M149 196v-25c-58-44-34-120 32-120s88 76 30 120v25Z"/><path class="terra none" d="M150 219h61m-48 21h35M180 12v17M73 62l20 17M267 78l20-17M48 143h27m211 0h27"/>
{% elif icon == 'cursor' %}
<path d="M105 29v181l50-44 39 70 35-20-41-65 68-17Z"/><path class="terra none" d="M57 27L42 12m14 74H29M118 4v-25"/>
{% elif icon == 'window' %}
<rect x="24" y="37" width="312" height="198" rx="19"/><path class="none" d="M24 83h312M52 60h3m19 0h3m19 0h3M94 122l-35 37 35 37m172-74 35 37-35 37"/><path class="terra none" d="M204 114l-49 91"/>
{% endif %}
</svg></div>{% endif %}
{% if platform == 'tiktok' %}{{ depth_html|safe }}{% endif %}
{% if platform == 'instagram' %}<div class="photo-window">{% endif %}
<img class="subject" src="{{ photo_uri }}" alt="Miguel, original photo cutout">
{% if platform == 'instagram' %}</div>{% endif %}
<div class="portrait-base"></div>
<div class="footer">{{ handle }}</div>
</main></body></html>
