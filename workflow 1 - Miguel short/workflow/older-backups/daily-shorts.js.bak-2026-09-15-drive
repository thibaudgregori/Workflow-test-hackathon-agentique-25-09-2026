const matteReviewWithFallback = async (v, ph) => {
  const r1 = await spawn(MATTE_REVIEW(v, 0), { label: 'matte_review:' + v.id, phase: ph, model: 'opus', effort: 'medium', schema: MATTE_REVIEW_SCHEMA })
  if (r1 && r1.verdict === 'PASS') return { ok: true, verdict: 'PASS', reasons: r1.reasons, fallback: false }
  log(`${v.id}: MATTE HOLD - ${r1 ? r1.reasons : 'the matte viewer returned nothing'}; running the SAM2 fallback`)
  const fb = await spawn(MATTE_FALLBACK(v), { label: 'matte_fallback:' + v.id, phase: ph, effort: 'low', schema: { type: 'object', required: ['status'], properties: {
    status: { type: 'string' }, installed: { type: 'string' }, error: { type: 'string' }, wall_s: { type: 'number' } } } })
  if (!fb || fb.status !== 'ok') {
    needsMiguel.push({ id: v.id, what: 'the SAM2 matte fallback', error: (fb && fb.error) || 'the fallback runner returned nothing', why: `the matte viewer held the MatAnyone2 matte (${r1 ? r1.reasons : 'no verdict'}) and the fallback did not produce a matte` })
    return { ok: false, verdict: 'HOLD', reasons: (r1 && r1.reasons) || '', fallback: true, error: (fb && fb.error) || 'no fallback' }
  }
  const r2 = await spawn(MATTE_REVIEW(v, 1), { label: 'matte_review:' + v.id + ' r2', phase: ph, model: 'opus', effort: 'medium', schema: MATTE_REVIEW_SCHEMA })
  if (r2 && r2.verdict === 'PASS') return { ok: true, verdict: 'PASS', reasons: r2.reasons, fallback: true }
  needsMiguel.push({ id: v.id, what: 'the cutout matte', error: (r2 && r2.reasons) || 'the second matte viewer returned nothing', why: 'held twice: MatAnyone2 and the SAM2 fallback; sheets under review/matte_' + v.id + ' - Miguel or Codex Astra decides, nobody hand-cuts an alpha' })
  return { ok: false, verdict: 'HOLD', reasons: (r2 && r2.reasons) || '', fallback: true }
}

