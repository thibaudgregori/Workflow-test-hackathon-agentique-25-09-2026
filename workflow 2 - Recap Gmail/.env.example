# Copier en .env.local et remplir. .env.local n'est jamais commité.

# Gmail, lecture seule en IMAP : mot de passe d'application (pas ton vrai mot de passe)
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Clé de l'IA : jamais dans le code
OPENAI_API_KEY=

# Par défaut les appels passent par la passerelle Deadweight.
# Pour appeler OpenAI en direct : OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
RECAP_MODEL=gpt-4o-mini
